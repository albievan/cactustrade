# cactusTrade deployment defaults. Docker Compose reads this file automatically and
# deploy.sh uses it for Docker Desktop, Podman, k3s and k8s. NO SECRETS HERE: passwords and
# keys live in files under SECRETS_DIR (created by `./deploy.sh --install`). Per-machine
# overrides go in .env.local (not in git). Every value is explained in README.md.

# ---- Volume mappings (Docker; host paths, relative paths are relative to this file) ----
DATA_DIR=./data/app
MARIADB_DATA_DIR=./data/mariadb
BACKUP_DIR=./backups
SECRETS_DIR=./secrets

# ---- Network ----
# The app serves HTTPS itself (self-signed certificate in DATA_DIR/tls unless you set
# CACTUSTRADE_TLS_CERT/KEY); browse to https://localhost:${HTTPS_PORT}.
HTTPS_PORT=8443

# ---- Image ----
CACTUSTRADE_IMAGE=cactustrade:latest

# ---- Application ----
TZ=Europe/London
CACTUSTRADE_LOG_LEVEL=info
CACTUSTRADE_COOKIE_SECURE=true
# Your eToro DEMO keys can come from the environment of the shell that runs deploy.sh:
#   export ETORO_DEMO_PUB=...   (eToro "Public API Key" → x-api-key)
#   export ETORO_DEMO_PK=...    (eToro "User Key"       → x-user-key)
# deploy.sh copies them into SECRETS_DIR; they are never written to this file.

# ---- E-mail ----
# The address users open the app at, for links in e-mails (password reset). Empty: deploy.sh
# uses https://<this machine's LAN address>:${HTTPS_PORT}.
CACTUSTRADE_PUBLIC_URL=
# The deployment's mail server, used while none is switched on in the app (Setup → E-mail,
# Gmail by default). Default: the bundled Mailpit test mailbox, which keeps every e-mail and
# shows it at http://localhost:${MAILPIT_PORT} (no sign-in; this machine only). Its password,
# if any, goes in ${SECRETS_DIR}/smtp_password, never here. k3s/k8s have no Mailpit.
CACTUSTRADE_SMTP_HOST=mailpit
CACTUSTRADE_SMTP_PORT=1025
CACTUSTRADE_SMTP_TLS=none
CACTUSTRADE_SMTP_USER=
CACTUSTRADE_SMTP_FROM="cactusTrade <cactustrade@localhost>"
# Docker only: optional containers (mailpit = the test mailbox; empty = none).
COMPOSE_PROFILES=mailpit
MAILPIT_PORT=8035
# Mailpit never delivers mail to anyone, so "Forgot password" is off while it is the only mail
# server. true = send reset links there anyway (only where whoever reads Mailpit is the user).
CACTUSTRADE_SMTP_TEST_MAILBOX_RESETS=false

# ---- Backups (./deploy.sh --backup-now / --restore; README "Backups and restore") ----
# age PUBLIC key(s) the backups are encrypted to (age1...; several separated by spaces), or a
# recipients file in CACTUSTRADE_BACKUP_RECIPIENT_FILE. A public key is not a secret; keep the
# matching identity (private key) OFF this machine. Empty: backups are plain gzip, with a warning.
CACTUSTRADE_BACKUP_RECIPIENT=
CACTUSTRADE_BACKUP_RECIPIENT_FILE=

# ---- Database (containers always use MariaDB; standalone uses SQLite) ----
MARIADB_DATABASE=cactustrade
MARIADB_USER=cactustrade

# ---- k3s / k8s ----
K8S_NAMESPACE=cactustrade
# Plain-HTTP node port, used only with K8S_HTTPS=false (a trusted lab network).
K8S_NODE_PORT=30443
# Storage class for the volumes ("" = the cluster default; k3s: local-path).
K8S_STORAGE_CLASS=
K8S_MARIADB_STORAGE=5Gi
K8S_DATA_STORAGE=1Gi
# HTTPS through the cluster's ingress controller (k3s: Traefik on 443); the app's Service is
# then ClusterIP. false = plain HTTP on K8S_NODE_PORT of every node (deploy.sh warns).
K8S_HTTPS=true
# The ingress controller (NetworkPolicy: only its pods reach the app; k3s: Traefik).
# ingress-nginx: K8S_INGRESS_NAMESPACE=ingress-nginx, K8S_INGRESS_POD_SELECTOR=app.kubernetes.io/name=ingress-nginx
K8S_INGRESS_NAMESPACE=kube-system
K8S_INGRESS_POD_SELECTOR=app.kubernetes.io/name=traefik
# Addresses / CIDRs allowed to set X-Forwarded-For: the ingress controller's pods only. Empty
# (safe default) = nobody; rate limits then see every client as the ingress controller. How
# to find the addresses: docs/RUNBOOK.md, "Trusted proxies on k3s/k8s".
K8S_TRUSTED_PROXIES=
K8S_HTTPS_HOST=
K8S_TLS_CERT=
K8S_TLS_KEY=
# k8s only: registry to push the image to (k3s imports it directly).
K8S_REGISTRY=
