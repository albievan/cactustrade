# cactusTrade deployment defaults. Docker Compose reads this file automatically and
# deploy.sh uses it for Docker Desktop, Podman, k3s and k8s. NO SECRETS HERE: passwords and
# keys live in files under SECRETS_DIR (created by `./deploy.sh --install`). Per-machine
# overrides go in .env.local (not in git). Every value is explained in README.md.

# ---- Volume mappings (Docker; host paths, relative paths are relative to this file) ----
DATA_DIR=./data/app
MARIADB_DATA_DIR=./data/mariadb
BACKUP_DIR=./backups
SECRETS_DIR=./secrets

# ---- Network ----
# The app serves HTTPS itself (self-signed certificate in DATA_DIR/tls unless you set
# CACTUSTRADE_TLS_CERT/KEY); browse to https://localhost:${HTTPS_PORT}.
HTTPS_PORT=8443

# ---- Image ----
CACTUSTRADE_IMAGE=cactustrade:latest

# ---- Application ----
TZ=Europe/London
CACTUSTRADE_LOG_LEVEL=info
CACTUSTRADE_COOKIE_SECURE=true
# Your eToro DEMO keys can come from the environment of the shell that runs deploy.sh:
#   export ETORO_DEMO_PUB=...   (eToro "Public API Key" → x-api-key)
#   export ETORO_DEMO_PK=...    (eToro "User Key"       → x-user-key)
# deploy.sh copies them into SECRETS_DIR; they are never written to this file.

# ---- Database (containers always use MariaDB; standalone uses SQLite) ----
MARIADB_DATABASE=cactustrade
MARIADB_USER=cactustrade

# ---- k3s / k8s ----
K8S_NAMESPACE=cactustrade
K8S_NODE_PORT=30443
# Storage class for the volumes ("" = the cluster default; k3s: local-path).
K8S_STORAGE_CLASS=
K8S_MARIADB_STORAGE=5Gi
K8S_DATA_STORAGE=1Gi
# HTTPS through the cluster's ingress controller (k3s: Traefik on 443).
K8S_HTTPS=true
K8S_HTTPS_HOST=
K8S_TLS_CERT=
K8S_TLS_KEY=
# k8s only: registry to push the image to (k3s imports it directly).
K8S_REGISTRY=
